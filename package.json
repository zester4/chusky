{
  "name": "tg-agent",
  "version": "3.0.0",
  "description": "Chusky AI Agent powered by Composio + OpenRouter",
  "main": "dist/index.js",
  "bin": {
    "chusky": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dashboard": "npm --prefix chusky-web run dev",
    "build": "tsc",
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts chat",
    "telegram": "tsx src/index.ts",
    "setup": "tsx src/cli.ts setup",
    "auth:migrate": "tsx src/migrate-auth.ts",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:sdk": "tsx --test --test-concurrency=1 sdk/tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@better-auth/redis-storage": "^1.7.2",
    "@composio/core": "^0.18.0",
    "@daytona/sdk": "^0.207.0",
    "@google/design.md": "^0.4.0",
    "@hono/node-server": "^1.13.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@upstash/qstash": "^2.11.0",
    "@upstash/workflow": "^1.3.3",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.31.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pptxgenjs": "4.0.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "allowScripts": {
    "keytar@7.9.0": true
  }
}
