# This is a separate process environment. Do not copy keys into source control.
TWILIO_MEDIA_BRIDGE_SECRET=
DEEPGRAM_API_KEY=
# Optional documented Deepgram TTS region. Keep the default unless latency
# measurements justify a canary.
DEEPGRAM_TTS_API_HOST=api.deepgram.com
# Optional parent-account fast path for Twilio's signed WebSocket handshake.
# Managed customer subaccount tokens must never be placed in this service;
# the root authorization endpoint validates those streams per call.
TWILIO_AUTH_TOKEN=
# Set this to the public WSS endpoint only when Twilio voice is enabled.
TWILIO_MEDIA_STREAM_URL=wss://your-voice-domain.example/twilio/stream
# Low-latency conversational-turn detection and streaming speech.
VOICE_STT_MODEL=flux-general-en
VOICE_STT_EAGER_EOT_THRESHOLD=0.45
VOICE_STT_EOT_THRESHOLD=0.65
VOICE_STT_EOT_TIMEOUT_MS=800
# Optional comma-separated Flux keyterms for generic/inbound calls. Outbound
# call facts are added dynamically from the authenticated call context.
VOICE_STT_KEYTERMS=
# Optional bounded adaptation after three clean/resumed turns. Keep disabled
# for the first canary, then enable after comparing latency and interruption
# metrics against the static baseline.
VOICE_STT_ADAPTIVE_ENDPOINTING=false
VOICE_TTS_MODEL=flux-haley-en
# Deepgram Flux TTS beta expressivity: -2 calm, 0 neutral, +2 animated.
# Keep 0 for the safest baseline; +1 is the recommended canary value.
VOICE_TTS_EXPRESSIVITY=0
# Flux streaming speed: 0.5–1.5 in 0.05 increments. 1.05 is a modestly
# faster conversational baseline; measure interruption and comprehension before
# raising it further.
VOICE_TTS_SPEED=1.05
# Twilio-only opt-in. false preserves the Deepgram Flux TTS path above.
VOICE_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
VOICE_TWILIO_NATIVE_MULAW=true
VOICE_BARGE_IN_MIN_CHARS=2
# Time allowed for a final turn to begin speaking. This is not a maximum
# answer duration; once audio starts, the response is allowed to finish.
# Dead-air recovery guard; normal streamed turns continue beyond this once
# their first audio has started.
VOICE_TURN_START_BUDGET_MS=2500
VOICE_TURN_FALLBACK_ENABLED=true
# After a tool-start update, speak one bounded recovery update only if the tool is still running.
VOICE_TOOL_PROGRESS_DELAY_MS=2500
# Safety fallback only; normal pre-tool wording is generated by the agent model.
VOICE_TOOL_PROGRESS_MESSAGE=I’m still working on that, thanks for your patience.
# For Railway, these point to the public Chusky service. The bridge authenticates
# requests with TWILIO_MEDIA_BRIDGE_SECRET.
CHUSKY_VOICE_TURN_URL=https://chusky.up.railway.app/internal/twilio/turn
CHUSKY_VOICE_CONTEXT_URL=https://chusky.up.railway.app/internal/twilio/context
CHUSKY_VOICE_STATUS_URL=https://chusky.up.railway.app/internal/twilio/status
CHUSKY_VOICE_STREAM_AUTHORIZE_URL=https://chusky.up.railway.app/internal/twilio/stream-authorize
# Optional Recall.ai meetings (Twilio remains independently configured).
# This secret must match Chusky root RECALL_MEDIA_BRIDGE_SECRET.
RECALL_MEETINGS_ENABLED=false
RECALL_MEDIA_BRIDGE_SECRET=
# Meeting-only transcription. Flux confirmed end-of-turn events are the
# default; set nova-3 only as a rollback. Independent of Twilio Flux settings.
RECALL_STT_MODEL=flux-general-en
RECALL_STT_EAGER_EOT_THRESHOLD=0.45
RECALL_STT_EOT_THRESHOLD=0.55
RECALL_STT_EOT_TIMEOUT_MS=500
RECALL_NOVA_ENDPOINTING_MS=500
RECALL_NOVA_UTTERANCE_END_MS=1000
# Nova-only transcript formatting controls. These do not apply to Flux.
# no_delay can reduce latency but may skip entity formatting.
RECALL_NOVA_SMART_FORMAT=true
RECALL_NOVA_NO_DELAY=false
CHUSKY_RECALL_TURN_STREAM_URL=https://chusky.up.railway.app/internal/recall/turn-stream
CHUSKY_RECALL_COMMIT_TURN_URL=https://chusky.up.railway.app/internal/recall/commit-turn
CHUSKY_RECALL_MEDIA_AUTHORIZE_URL=https://chusky.up.railway.app/internal/recall/media-authorize
# Optional shared-screen vision. Prefer Recall's official workspace
# verification setting name and use the same value on Chusky root and voice.
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Historical Chusky alias; use only when the official name is unavailable.
RECALL_REALTIME_SECRET=
CHUSKY_RECALL_VISUAL_FRAME_URL=https://chusky.up.railway.app/internal/recall/visual-frame
RECALL_MAX_MEETING_SECONDS=7200
RECALL_MAX_ACTIVE_MEETINGS=4
RECALL_COPILOT_MIN_INTERVAL_SECONDS=8
# Maximum wait for the first meeting response audio before a short recovery
# prompt is used. This is not a maximum response duration.
RECALL_TURN_START_BUDGET_MS=6000
RECALL_TURN_FALLBACK_ENABLED=true
RECALL_COPILOT_MAX_EVALUATIONS=120
VOICE_BRIDGE_HOST=0.0.0.0
# Local/Oracle fallback. Railway's injected PORT takes precedence.
VOICE_BRIDGE_PORT=3004
VOICE_BRIDGE_MAX_CALL_SECONDS=7200
VOICE_BRIDGE_MAX_ACTIVE_CALLS=4
# The root Chusky service enforces the distributed limit across all bridge
# replicas. This local value remains a fail-safe per replica.
VOICE_BRIDGE_LOG_LEVEL=INFO
