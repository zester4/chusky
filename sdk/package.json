{
  "name": "@chusky/sdk",
  "version": "1.5.1",
  "description": "TypeScript SDK for Chusky's developer API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zester4/chusky",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/zester4/chusky/issues"
  },
  "homepage": "https://github.com/zester4/chusky/tree/main/sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "docs",
    "docs.json",
    "openapi.yaml",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
