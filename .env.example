# ── Required ─────────────────────────────────────────────────────────────────

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
# Your public URL (no trailing slash). Leave BLANK for local polling/dev mode.
# Set AFTER first deploy, then redeploy.
WEBHOOK_URL=
DASHBOARD_URL=

# Random string to secure the Telegram webhook endpoint
WEBHOOK_SECRET=

# The CLI connects to the deployed service using CHUSKY_SERVER_URL on the client.
# CLI devices are paired from Telegram with /cli link; no CLI secret is stored here.
# Optional fallback encryption key for the CLI token when native keytar is unavailable.
# Prefer the OS credential vault; never commit this value.
CHUSKY_CLI_SECRET=
# Private Oracle root/bootstrap key; enables the versioned /v1 SDK surface and
# provisions scoped chsk_ project keys. Keep this server-side only; never ship
# it to browser clients or developers.
CHUSKY_PROJECT_KEY=
# Cloudflare R2 private media storage (presigned URLs; do not expose these credentials).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SDK_MAX_FILE_BYTES=26214400

# HTTP port (most cloud platforms set this automatically)
PORT=8080

# ── Better Auth (web dashboard) ──────────────────────────────────────────────
# Enable the Hono auth routes only after configuring the database and secret.
BETTER_AUTH_ENABLED=false
# Generate with: openssl rand -base64 32 (never commit the result)
BETTER_AUTH_SECRET=
# Public backend origin used to construct verification and reset URLs.
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated frontend origins allowed to send credentialed auth requests.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3010
# Frontend origin used for workspace invitation links (production: your dashboard URL).
CHUSKY_WEB_ORIGIN=http://localhost:3000
# Production: Neon pooled PostgreSQL connection string used by the running app.
# Leave empty only for local SQLite development; production refuses SQLite.
BETTER_AUTH_DATABASE_URL=
# Neon direct (non-pooler) PostgreSQL URL. Used only by `npm run auth:migrate`.
BETTER_AUTH_MIGRATION_DATABASE_URL=
# Local development fallback only. Never use this path in production.
BETTER_AUTH_DATABASE=./data/better-auth.sqlite
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Resend is optional in local development and required in production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# ── Chuck's model ─────────────────────────────────────────────────────────────
# Any OpenRouter model ID — https://openrouter.ai/models
# Users can override per-session with /model
DEFAULT_MODEL=minimax/minimax-m3:free
# Model used by shared Telegram/iMessage/Slack/WhatsApp conversations unless overridden per group.
GROUP_DEFAULT_MODEL=minimax/minimax-m3:free
VOICE_MODEL=google/gemini-3.5-flash
VOICE_FALLBACK_MODELS=google/gemini-2.5-flash
VOICE_MAX_TOKENS=192
VISION_MODEL=openai/gpt-5.6-luna
TRANSCRIPTION_MODEL=openai/gpt-transcribe
TTS_MODEL=deepgram/flux-tts:free
TTS_VOICE=flux-kit-en
IMAGE_MODEL=x-ai/grok-imagine-image-2.0
QSTASH_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
# Root-only HMAC secret for deployment-side real-provider smoke attestations.
# Keep this separate from provider credentials and never expose it to the agent.
PROVIDER_SMOKE_SIGNING_SECRET=
VIDEO_WORKFLOW_URL=
REMINDER_WORKFLOW_URL=
JOB_WORKFLOW_URL=
TRIGGER_WORKFLOW_URL=
# Scheduled durable tasks use WEBHOOK_URL/workflows/task; no separate URL is needed.
VIDEO_MODEL=bytedance/seedance-2.0-mini

# ── Optional third-party MCP clients ─────────────────────────────────────────
# Server-side, owner-scoped registry. Never put bearer tokens in this JSON.
# Legacy fallback only: prefer the checked-in public catalog at src/mcp/mcp.json
# Example: [{"id":"linear","name":"Linear MCP","url":"https://mcp.example.com/mcp","ownerIds":[123456789],"auth":{"type":"bearer","tokenEnv":"MCP_LINEAR_TOKEN"},"allowedTools":["search_issues"],"requireApproval":true}]
MCP_ENABLED=false
MCP_SERVERS_JSON=[]
MCP_CONNECTION_ENCRYPTION_KEY=
MCP_TOOL_TIMEOUT_MS=20000
MCP_MAX_SERVERS=20
MCP_MAX_TOOLS_PER_SERVER=100
MCP_MAX_RESULT_CHARS=20000

# ── Stripe Link Agent Wallet (optional) ─────────────────────────────────────
# Link owns the payment credentials. Chusky stores only encrypted OAuth
# tokens and bounded spend metadata; card numbers and payment tokens never
# enter model or API input.
LINK_AGENT_WALLET_ENABLED=false
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
LINK_PUBLISHABLE_KEY=
LINK_OAUTH_CALLBACK_URL=
LINK_AGENT_WALLET_ENCRYPTION_KEY=
LINK_API_BASE_URL=https://api.link.com
LINK_AUTH_BASE_URL=https://login.link.com
LINK_TEST_MODE=false
LINK_MAX_SPEND_CENTS=50000
LINK_REQUEST_TIMEOUT_MS=20000

# ── Treg external intelligence gateway ──────────────────────────────────────
# Keep the token server-side. Treg provides live external provider data;
# authenticated
# actions in user apps continue to use Composio.
TREG_ENABLED=false
TREG_BASE_URL=https://treg.to
TREG_TOKEN=
TREG_TIMEOUT_MS=30000
TREG_MAX_RETRIES=2
TREG_DAILY_BUDGET_USD=5
TREG_MISSION_BUDGET_USD=1
TREG_PER_CALL_SOFT_CAP_USD=0.25
TREG_RATE_LIMIT_PER_MINUTE=30
# Optional Chusky organization-scoped credentials. Values may be a token string
# or {"token":"...","tregOrgId":"org_..."}; never expose this to clients.
TREG_ORG_TOKENS_JSON={}

# ── TinyFish public web search and page extraction ──────────────────────────
# Server-side only; tools stay hidden from model and worker tool lists until set.
TINYFISH_API_KEY=

# ── Optional native channel adapters ──────────────────────────────────────────
# Slack: enable only after the public URLs are deployed.
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
# Optional for a single workspace. OAuth installations are stored in Redis.
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
SENDBLUE_ENABLED=false
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_WORKFLOW_URL=
# Twilio handles inbound and default outbound calls; Bland is an optional outbound alternative.
# TWILIO_CALLER_ID must be a Twilio-verified caller ID.
TWILIO_VOICE_ENABLED=false
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_WEBHOOK_URL=
TWILIO_SMS_STATUS_CALLBACK_URL=

# Standard X Direct Messages (official @chat-adapter/x, regular unencrypted DMs)
X_ENABLED=false
# Choose a static user token, or managed OAuth refresh. Long-running production
# deployments should use X_CLIENT_ID + X_REFRESH_TOKEN + X_ENCRYPTION_KEY.
X_USER_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_ENCRYPTION_KEY=
X_USERNAME=
X_API_BASE_URL=https://api.x.com
# Shared X app consumer secret for webhook CRC and signature checks.
X_CONSUMER_SECRET=

# Optional legacy encrypted XChat adapter. Its token/PIN are not X DM OAuth credentials.
XCHAT_ENABLED=false
XCHAT_BOT_TOKEN=
# App-only bearer token used to list X Activity subscriptions. The bot token
# remains the user-context token for identity and private subscription writes.
X_BEARER_TOKEN=
XCHAT_PIN=
X_BOT_USERNAME=
X_VERIFY_SIGNATURES=true
XCHAT_WEBHOOK_URL=
XCHAT_WEBHOOK_ID=
TWILIO_CALLER_ID=
# Public HTTPS Chusky callback host and public WSS media-bridge endpoint.
TWILIO_WEBHOOK_BASE_URL=
TWILIO_MEDIA_STREAM_URL=
# Secret shared only with Chusky's private Twilio/Deepgram media bridge.
TWILIO_MEDIA_BRIDGE_SECRET=
# Configure the Twilio number's incoming Voice webhook to
# https://<TWILIO_WEBHOOK_BASE_URL-host>/twilio/inbound. Inbound calls are
# rejected unless the caller is in this list and mapped to this Telegram owner.
TWILIO_INBOUND_ENABLED=false
TWILIO_INBOUND_OWNER_USER_ID=
TWILIO_INBOUND_ALLOWED_CALLERS=
# Optional business-call mode. Business callers begin at identified tier;
# numbers in this allowlist may use verified-tier read-only context.
TWILIO_INBOUND_CALL_PROFILE=personal
TWILIO_INBOUND_VERIFIED_CALLERS=

  # Optional Recall.ai live meeting assistant for Zoom, Google Meet, Teams, and Webex.
# Configure the same RECALL_MEDIA_BRIDGE_SECRET on the separate chusky-voice
# service. Configure Recall's Bot Status Change webhook as /recall/webhook and
# copy its signing secret to RECALL_WEBHOOK_SECRET. The media page is hosted by
# chusky-voice. Recall is configured for no retained recordings/transcripts.
# Optional chat also needs QSTASH_TOKEN, Redis, public HTTPS WEBHOOK_URL, and a
  # Recall workspace verification secret (distinct from the status-hook secret).
  # Copy this to chusky-voice only if enabling opt-in screen-share understanding.
RECALL_MEETINGS_ENABLED=false
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_BOT_NAME=Chusky
RECALL_MEDIA_PAGE_URL=
RECALL_WEBHOOK_SECRET=
# Prefer Recall's official workspace verification setting name. The historical
# RECALL_REALTIME_SECRET alias remains supported for existing deployments.
RECALL_WORKSPACE_VERIFICATION_SECRET=
RECALL_REALTIME_SECRET=
RECALL_MEDIA_BRIDGE_SECRET=
# Required only to retain an explicitly requested searchable transcript; keep stable through its expiry.
RECALL_TRANSCRIPT_ENCRYPTION_KEY=
RECALL_COPILOT_MIN_INTERVAL_SECONDS=4

# Optional Bland AI parallel voice provider. Set this independently from Twilio.
BLAND_VOICE_ENABLED=false
BLAND_API_KEY=
BLAND_WEBHOOK_SECRET=
BLAND_WEBHOOK_URL=https://<your-chusky-host>/bland/webhook
# Generate a separate 32+ character URL-safe secret and use it in the provisioned Bland custom tool.
BLAND_CONSULT_TOOL_SECRET=
# Set to the TL-* ID printed by `npm run setup:bland-tool`.
BLAND_CONSULT_TOOL_ID=
BLAND_VOICE=maya

# ── Daytona isolated computer (optional) ─────────────────────────────────────
# Get an API key from Daytona. Leave DAYTONA_API_KEY blank to disable these tools.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# Optional custom image. Required when using DAYTONA_CPU/MEMORY_GIB/DISK_GIB;
# the default browser snapshot/code-toolbox path rejects inline resources.
DAYTONA_IMAGE=
# Optional reusable snapshot name. Blank uses Daytona's default snapshot.
DAYTONA_SNAPSHOT=
# Optional resources for newly created workspaces from DAYTONA_IMAGE. Daytona
# currently supports up to 4 CPU, 8 GiB memory, and 10 GiB disk on the standard
# tier. Existing retained workspaces are not resized implicitly.
DAYTONA_CPU=
DAYTONA_MEMORY_GIB=
DAYTONA_DISK_GIB=
# Optional rendering snapshot with Python 3, LibreOffice, Poppler, QPDF, and
# fonts. Blank builds the renderer image on demand for temporary QA sandboxes.
DAYTONA_RENDERER_SNAPSHOT=
# Daytona is Chusky's isolated working computer. Broad outbound access lets it
# install packages, use browsers, fetch project dependencies, and build artifacts.
# Set true only for a locked-down deployment. DAYTONA_DOMAIN_ALLOW_LIST takes
# precedence and can restrict access to selected domains instead.
DAYTONA_NETWORK_BLOCK_ALL=false
DAYTONA_DOMAIN_ALLOW_LIST=
# Optional. Leave 0 for container targets; auto-pause requires a pausable
# target such as linux-vm. Value is minutes.
DAYTONA_AUTO_PAUSE_INTERVAL=0
# Private human takeovers for CAPTCHA/2FA use a signed noVNC preview of the
# same retained desktop. Defaults work with Daytona Computer Use; keep the TTL short.
DAYTONA_VNC_PORT=6080
DAYTONA_BROWSER_HANDOFF_TTL_SECONDS=300
# E2B automated browser (optional). This provides retained Playwright/Chromium
# browsing, normal vault login, and the same-session CAPTCHA/2FA noVNC handoff.
# Build the template once with `npm run e2b:template:build`, then set its name.
# Daytona remains the file/artifact/computer-use fallback backend.
E2B_ENABLED=false
E2B_API_KEY=
E2B_BROWSER_TEMPLATE=chusky-browser-playwright
E2B_TIMEOUT_MS=900000
E2B_REQUEST_TIMEOUT_MS=120000

# ── Credential Vault (optional, server-side encrypted website logins) ────────
# Enable only after configuring the Cloudflare vault Worker, its D1 binding,
# and its Worker Secrets. Chusky never sends passwords to the model; the
# private one-time HTTPS form posts directly to the Worker and Daytona retains
# browser cookies only in the user's workspace.
VAULT_ENABLED=false
# Cloudflare Worker URL. The Worker owns D1 and VAULT_MASTER_KEY; never add
# VAULT_MASTER_KEY to Railway or this file.
VAULT_BROKER_URL=
# Must match the BROKER_HMAC_SECRET stored as a Worker Secret.
VAULT_BROKER_HMAC_SECRET=

# ── Chuck's personality (optional — default is already set) ──────────────────
# SYSTEM_PROMPT=You are Chuck...

# ── Composio session config ───────────────────────────────────────────────────
# Enable COMPOSIO_MANAGE_CONNECTIONS (lets Chuck surface OAuth links inline)
ENABLE_MANAGE_CONNECTIONS=true

# Allow multiple connected accounts per Composio toolkit. Aliases are supplied
# with /connect <toolkit> <alias>; the default maximum is five per toolkit.
COMPOSIO_MULTI_ACCOUNT_ENABLED=true
COMPOSIO_MAX_ACCOUNTS_PER_TOOLKIT=5
# Require the agent to identify the account for a tool call when several exist.
COMPOSIO_REQUIRE_EXPLICIT_ACCOUNT=true

# Callback URL after user connects an app via /connect
# Leave blank to use Composio's default success page
COMPOSIO_CALLBACK_URL=

# Secret used to verify Composio trigger webhook signatures
COMPOSIO_WEBHOOK_SECRET=

# Enable COMPOSIO_REMOTE_BASH_TOOL + COMPOSIO_REMOTE_WORKBENCH
ENABLE_SANDBOX=true

# Sandbox compute tier: standard (1 vCPU/1GB) | medium | large | xlarge
SANDBOX_SIZE=standard

# Composio v3.1 trigger subscription. When set, Chusky reconciles this URL
# at startup and explicitly requests the V3 `composio.trigger.message` payload.
# Leave blank to derive `${WEBHOOK_URL}/composio/triggers`.
COMPOSIO_WEBHOOK_URL=

# ── Agent loop ────────────────────────────────────────────────────────────────
# Max model/tool cycles per message before a final, explicitly incomplete closeout (1-100)
MAX_TOOL_ROUNDS=70
# Optional per-user accumulated cost cap in USD; 0 disables the cap
USER_COST_CAP=0
# OpenRouter client safety: the first attempt is aborted after this many
# milliseconds; a transient retry gets a bounded larger window capped at 120s.
# Provider fallback remains enabled; add comma-separated backup model IDs only
# after verifying they support the tools/media your agent needs.
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_ATTEMPTS=2
# Hard-bounded to 1-5 attempts by the runtime.
OPENROUTER_ARTIFACT_MAX_TOKENS=12000
OPENROUTER_FALLBACK_MODELS=
# OpenRouter routing preference in seconds (0 disables the preference). This
# is not the client timeout above.
OPENROUTER_PREFERRED_MAX_LATENCY_SECONDS=45
# IANA timezone used for Chusky's trusted local-time context (for example Europe/London).
CHUSKY_TIMEZONE=UTC

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=10
RATE_WINDOW_SECONDS=60

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs. Leave blank to allow everyone.
# Get your ID from @userinfobot on Telegram.
ALLOWED_USERS=

# ── Conversation memory ───────────────────────────────────────────────────────
MAX_HISTORY=20

# ── Redis (optional but recommended for production) ───────────────────────────
# Session history, rate limits, durable task state, leases, and task audit trails persist across restarts.
# Without Redis, everything resets when the container restarts.
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=

# Optional semantic knowledge search. Create a Hybrid Upstash Vector index with
# its managed OpenAI embedding model and BM25, then copy its REST credentials.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Optional fallback encryption secret for CLI tokens when OS keychain support
# is unavailable. Prefer the native Windows Credential Manager, macOS Keychain,
# or Linux Secret Service backend supplied by the optional keytar dependency.
CHUSKY_CLI_SECRET=

# How long to keep session data in Redis (seconds). Default: 30 days.
SESSION_TTL=2592000

# ── Logging ───────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info

# Optional PostHog product analytics and server-side error tracking.
# Never send prompts, tool arguments, document contents, tokens, or responses.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Jev decision routing (TypeSafe System One) ──────────────────────────────
# Jev routes each turn to the right skill(s), Composio app and exact action(s),
# and Treg tool/endpoint using calibrated probabilities. It only proposes
# routes: allowlists, account scope, approvals, and Treg budgets stay in code.
# Jev is additive; keyword routing always remains as the fallback.
#
# Mode: off (deterministic routing only) | shadow (log established Jev
# routing comparisons, with deterministic autonomy) | enforce (apply confident
# Jev routes and bounded autonomy proposals with deterministic fallback).
# Recommended rollout: shadow -> review `jev.shadow` logs -> enforce.
JEV_MODE=off
# openrouter reuses OPENROUTER_API_KEY; typesafe calls api.typesafe.ai directly.
JEV_PROVIDER=openrouter
# Only for JEV_PROVIDER=typesafe.
JEV_API_KEY=
# Pinned model. Blank = typesafe/jev-1.13 (OpenRouter) or jev-1.13.0 (TypeSafe).
JEV_MODEL=
# Surfaces Jev may route (comma-separated): skills, composio, treg, autonomy, browser.
# Autonomy covers bounded next-action, pulse priority, mission progression,
# signal triage, follow-up, memory, delegation, and recovery proposals.
JEV_SURFACES=skills,composio,treg,autonomy,browser

# Latency. One shared per-turn deadline covers skills, Treg, the connected-
# account lookup, and Composio routing; slower routes fall back to keywords.
JEV_TIMEOUT_MS=1500
JEV_TURN_BUDGET_MS=3000

# Request sizing. Large option sets (101 skills, 500+ toolkits, hundreds of
# actions) are split into shards and ranked in a two-round tournament.
JEV_MAX_REQUEST_TOKENS=24000
JEV_MAX_OPTIONS_PER_QUESTION=120

# Thresholds (0-1). Tune from shadow logs before enforcing.
# Minimum Choice confidence before a Jev route is trusted.
JEV_MIN_CONFIDENCE=0.45
# Skill: minimum rank probability for a second primary skill.
JEV_SKILL_MIN_PROBABILITY=0.2
# Skill: independent "would this skill help" score needed to load it.
JEV_SKILL_VERIFY_THRESHOLD=0.5
# Action: independent "is this action needed" score needed to list it.
JEV_ACTION_VERIFY_THRESHOLD=0.5
# Action: probability needed to expose a connected-app action as a direct tool.
JEV_INJECT_ACTION_MIN_PROBABILITY=0.55
# Toolkit: minimum probability for an app to be routed (top two at most).
JEV_TOOLKIT_MIN_PROBABILITY=0.25

# Composio catalogue routing. When true, Jev ranks Composio's full toolkit
# catalogue, not only connected apps, so a request can route to an app the
# user has not connected yet. Chusky then offers the connection link via
# COMPOSIO_MANAGE_CONNECTIONS; unconnected actions are listed but never
# exposed as executable tools until the app is connected.
JEV_COMPOSIO_ROUTE_UNCONNECTED=true
# Most-used toolkits to consider from the catalogue (20-2000; cached 6h).
JEV_COMPOSIO_CATALOG_LIMIT=500
